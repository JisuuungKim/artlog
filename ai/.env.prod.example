# 운영용 AI 환경변수. 복사해서 사용:
#   cp ai/.env.prod.example ai/.env.prod

# ── PostgreSQL (compose 내부 호스트명) ─────────────────────────
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=artlog_db
POSTGRES_USER=artlog_user
POSTGRES_PASSWORD=change-me-strong-password

# ── LLM ────────────────────────────────────────────────────────
OPENAI_API_KEY=

# ── 가사 검색 (correction_node) ────────────────────────────────
# 누락 시 가사 검색만 생략되고 레슨노트 생성은 계속됩니다(보정 품질만 저하).
TAVILY_API_KEY=

# ── LangSmith (선택) ───────────────────────────────────────────
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=artlog-ai
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ── 커넥션 풀 ──────────────────────────────────────────────────
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10
