# 운영용 Spring 환경변수. 복사해서 사용:
#   cp back/.env.prod.example back/.env.prod
#
# {DOMAIN} 자리는 .env.prod 의 DOMAIN 과 같은 값으로 채워주세요.

# ── DB / Redis (compose 내부 호스트명) ─────────────────────────
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/artlog_db
SPRING_DATASOURCE_USERNAME=artlog_user
SPRING_DATASOURCE_PASSWORD=change-me-strong-password
# 첫 배포에서는 update 로 스키마 자동 생성, 그 다음 validate 로 변경 권장
SPRING_JPA_HIBERNATE_DDL_AUTO=update

SPRING_DATA_REDIS_HOST=redis
SPRING_DATA_REDIS_PORT=6379

# ── JWT ────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-very-long-random-string-for-jwt-signing
JWT_ACCESS_TOKEN_EXPIRATION_SECONDS=3600
JWT_REFRESH_TOKEN_EXPIRATION_SECONDS=1209600

# ── 도메인 / OAuth redirect ────────────────────────────────────
# 프론트(Vercel)와 API(VPS)가 분리된 구성입니다.
#   - FRONTEND_BASE_URL : Vercel 프론트 도메인. CORS 허용 origin + OAuth 후 redirect 기준.
#   - OAUTH2_*          : OAuth 성공/실패 후 브라우저를 보낼 프론트 경로.
# OAuth 인증/콜백 자체(/oauth2/**, /login/oauth2/**)는 이 API 도메인에서 처리됩니다.
FRONTEND_BASE_URL=https://artlog.site
OAUTH2_AUTHORIZED_REDIRECT_URI=https://artlog.site/auth/callback
OAUTH2_FAILURE_REDIRECT_URI=https://artlog.site/auth/login
REFRESH_COOKIE_NAME=refresh_token
REFRESH_COOKIE_SECURE=true
# 프론트(artlog.site)와 API(api.artlog.site)가 같은 루트도메인이면 Lax 로 충분.
# 만약 프론트를 *.vercel.app 처럼 다른 사이트로 두면 None 으로 바꿔야 함(쿠키 전송됨, Secure 필수).
REFRESH_COOKIE_SAME_SITE=Lax

# ── OAuth 자격 ─────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_ISSUER=https://appleid.apple.com
APPLE_PUBLIC_KEY_URL=https://appleid.apple.com/auth/keys

# ── AI 서버 / 업로드 ───────────────────────────────────────────
AI_BASE_URL=http://ai:8001
APP_UPLOAD_DIR=/uploads
