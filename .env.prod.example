# 운영용 환경변수. 복사해서 사용:
#   cp .env.prod.example .env.prod
#
# 이 파일은 compose 자체의 substitution 과 db 컨테이너 환경변수에 쓰입니다.
# 같은 POSTGRES_PASSWORD 가 back/.env.prod, ai/.env.prod 에도 들어가야 합니다.

# ── Caddy / 도메인 ─────────────────────────────────────────────
# DOMAIN 은 VPS(Caddy)가 인증서를 받고 서비스할 "API 도메인" 입니다.
# 프론트(Vercel)는 같은 루트도메인의 다른 호스트로 둡니다. 예) 프론트=artlog.com / API=api.artlog.com
DOMAIN=api.artlog.com
ACME_EMAIL=you@example.com

# ── PostgreSQL (db 컨테이너) ───────────────────────────────────
POSTGRES_USER=artlog_user
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=artlog_db
